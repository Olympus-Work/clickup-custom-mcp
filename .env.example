# Copy to .env and fill in. .env is gitignored; this file is not — keep it empty of real values.

# Required. ClickUp: avatar -> Settings -> Apps -> API Token -> Generate
CLICKUP_API_TOKEN=

# Optional. Pin a workspace when the token can see more than one.
# Left blank, the first workspace the token sees is used.
CLICKUP_TEAM_ID=

# Optional. Requests/minute the client allows itself.
# Left blank, defaults to 90 — headroom under ClickUp's floor of 100.
CLICKUP_RATE_LIMIT=
